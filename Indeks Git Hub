<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Froggy Jumps - Game Edukasi Interaktif</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Quicksand', sans-serif;
            user-select: none;
            -webkit-user-select: none;
            overflow: hidden;
            background-color: #0284c7;
        }
        .font-game {
            font-family: 'Fredoka One', cursive;
        }
        canvas {
            display: block;
            touch-action: none;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(12px);
            border: 2px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 20px 30px rgba(0, 0, 0, 0.2);
        }
        .btn-game {
            transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 6px 0 rgba(0,0,0,0.25);
        }
        .btn-game:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 rgba(0,0,0,0.25);
        }
        /* Animations */
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        .animate-float {
            animation: float 3s ease-in-out infinite;
        }
    </style>
</head>
<body class="h-screen w-screen relative overflow-hidden bg-sky-900 text-slate-800">

    <!-- Top Right Action Controls -->
    <div class="absolute top-3 right-3 z-50 flex items-center gap-2">
        <button id="bgmToggleBtn" onclick="toggleBGM()" class="btn-game bg-amber-400 hover:bg-amber-300 text-amber-950 p-2.5 rounded-full font-bold flex items-center justify-center shadow-lg">
            <svg id="bgmIcon" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
            </svg>
        </button>
        <button id="fullscreenBtn" onclick="toggleFullScreen()" class="btn-game bg-emerald-500 hover:bg-emerald-400 text-white p-2.5 rounded-full font-bold shadow-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
            </svg>
        </button>
    </div>

    <div id="mainMenu" class="absolute inset-0 z-40 flex items-center justify-center p-4 bg-sky-900/80 backdrop-blur-md">
        <div class="glass-card max-w-xl w-full p-6 sm:p-8 rounded-3xl text-center space-y-6 max-h-[95vh] overflow-y-auto">
            <div class="animate-float">
                <div class="inline-block bg-emerald-500 text-white text-xs uppercase tracking-widest px-3 py-1 rounded-full font-bold mb-2">Media Pembelajaran Interaktif</div>
                <h1 class="font-game text-4xl sm:text-5xl text-emerald-600 drop-shadow-md">FROGGY JUMPS</h1>
                <p class="text-slate-600 text-sm font-semibold">Bantu katak melompat ke teratai jawaban yang benar!</p>
            </div>

            <div class="space-y-4 text-left">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">1. Pilih Materi & Tingkat Kelas</label>
                    <select id="subjectSelect" onchange="onSubjectChange()" class="w-full bg-white border-2 border-slate-200 rounded-xl p-3 font-semibold text-slate-700 focus:outline-none focus:border-emerald-500 shadow-sm">
                        <option value="math_sd">Perkalian & Pembagian (Kelas 2 - 3 SD)</option>
                        <option value="ipa_smp">Tata Surya & Planet (Kelas 7 SMP)</option>
                        <option value="bio_sd">Ciri-Ciri Makhluk Hidup (Kelas 3 SD)</option>
                        <option value="custom">-- Buat/Input Soal Custom --</option>
                    </select>
                </div>

                <!-- Custom Question Editor Box -->
                <div id="customEditor" class="hidden bg-slate-100 p-3 rounded-xl space-y-2 text-xs border border-slate-300">
                    <p class="font-bold text-slate-700">Format Soal Custom (JSON):</p>
                    <textarea id="customJsonInput" class="w-full h-24 p-2 font-mono text-xs rounded border border-slate-300 bg-white" placeholder='[{"q":"2+2=?","options":["3","4","5","6"],"ans":1}]'></textarea>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-2">2. Pilih Mode Permainan</label>
                    <div class="grid grid-cols-3 gap-3">
                        <button onclick="selectMode('solo')" id="btnSolo" class="mode-btn btn-game bg-emerald-500 text-white font-game p-3 rounded-2xl text-center border-2 border-emerald-600">
                            <div class="text-2xl">🐸</div>
                            <div class="text-sm">SOLO</div>
                            <div class="text-[10px] opacity-80">1 Pemain</div>
                        </button>
                        <button onclick="selectMode('duel')" id="btnDuel" class="mode-btn btn-game bg-slate-200 text-slate-700 font-game p-3 rounded-2xl text-center border-2 border-slate-300">
                            <div class="text-2xl">🐸 🐸</div>
                            <div class="text-sm">DUEL</div>
                            <div class="text-[10px] opacity-80">2 Pemain</div>
                        </button>
                        <button onclick="selectMode('squad')" id="btnSquad" class="mode-btn btn-game bg-slate-200 text-slate-700 font-game p-3 rounded-2xl text-center border-2 border-slate-300">
                            <div class="text-2xl">🐸 x 4</div>
                            <div class="text-sm">SQUAD</div>
                            <div class="text-[10px] opacity-80">4 Pemain</div>
                        </button>
                    </div>
                </div>

                <!-- Environmental Effects Toggle -->
                <div class="flex items-center justify-between pt-2">
                    <span class="text-xs font-bold text-slate-600">Efek Cuaca / Hujan Air</span>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="rainEffectToggle" checked class="sr-only peer">
                        <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                    </label>
                </div>
            </div>

            <!-- Start Button -->
            <button onclick="startGame()" class="btn-game w-full bg-amber-400 hover:bg-amber-300 text-amber-950 font-game text-xl py-4 rounded-2xl shadow-lg uppercase tracking-wider">
                Mulai Permainan 🚀
            </button>
        </div>
    </div>

    <div id="gameOverModal" class="hidden absolute inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/80 backdrop-blur-md">
        <div class="glass-card max-w-md w-full p-6 rounded-3xl text-center space-y-5">
            <h2 id="winnerTitle" class="font-game text-3xl text-emerald-600">PERMAINAN SELESAI!</h2>
            <div id="scoreSummary" class="space-y-2 text-slate-700 font-semibold text-sm"></div>
            <button onclick="returnToMenu()" class="btn-game w-full bg-emerald-500 text-white font-game text-lg py-3 rounded-xl">
                Kembali ke Menu Utama
            </button>
        </div>
    </div>

    <canvas id="gameCanvas" class="w-full h-full"></canvas>

    <script>
        // Audio Synthesizer to eliminate external asset errors
        class SoundEngine {
            constructor() {
                this.ctx = null;
                this.bgmInterval = null;
                this.bgmPlaying = false;
            }

            init() {
                if (!this.ctx) {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                }
            }

            playJump() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(150, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(400, this.ctx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.3, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.15);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.15);
            }

            playCorrect() {
                if (!this.ctx) return;
                const notes = [300, 400, 500, 600];
                notes.forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, this.ctx.currentTime + idx * 0.08);
                    gain.gain.setValueAtTime(0.25, this.ctx.currentTime + idx * 0.08);
                    gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + idx * 0.08 + 0.12);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(this.ctx.currentTime + idx * 0.08);
                    osc.stop(this.ctx.currentTime + idx * 0.08 + 0.12);
                });
            }

            playWrong() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(220, this.ctx.currentTime);
                osc.frequency.linearRampToValueAtTime(80, this.ctx.currentTime + 0.3);
                gain.gain.setValueAtTime(0.3, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.3);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.3);
            }

            playSplash() {
                if (!this.ctx) return;
                const bufferSize = this.ctx.sampleRate * 0.3;
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1;
                }
                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;
                const filter = this.ctx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(800, this.ctx.currentTime);
                filter.frequency.linearRampToValueAtTime(100, this.ctx.currentTime + 0.3);
                const gain = this.ctx.createGain();
                gain.gain.setValueAtTime(0.4, this.ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, this.ctx.currentTime + 0.3);
                noise.connect(filter);
                filter.connect(gain);
                gain.connect(this.ctx.destination);
                noise.start();
            }

            toggleBGM() {
                this.init();
                if (this.bgmPlaying) {
                    clearInterval(this.bgmInterval);
                    this.bgmPlaying = false;
                } else {
                    this.bgmPlaying = true;
                    let step = 0;
                    const melody = [261, 329, 392, 523, 392, 329];
                    this.bgmInterval = setInterval(() => {
                        if (!this.bgmPlaying) return;
                        const osc = this.ctx.createOscillator();
                        const gain = this.ctx.createGain();
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(melody[step % melody.length], this.ctx.currentTime);
                        gain.gain.setValueAtTime(0.05, this.ctx.currentTime);
                        gain.gain.linearRampToValueAtTime(0.001, this.ctx.currentTime + 0.2);
                        osc.connect(gain);
                        gain.connect(this.ctx.destination);
                        osc.start();
                        osc.stop(this.ctx.currentTime + 0.2);
                        step++;
                    }, 250);
                }
                return this.bgmPlaying;
            }
        }

        const sound = new SoundEngine();

        const QUESTION_DATABASE = {
            math_sd: [
                { q: "Berapakah hasil dari 6 × 7 ?", options: ["36", "42", "48", "54"], ans: 1 },
                { q: "Hasil dari 45 ÷ 5 adalah...", options: ["8", "9", "10", "7"], ans: 1 },
                { q: "Berapakah hasil dari 8 × 9 ?", options: ["64", "72", "81", "70"], ans: 1 },
                { q: "Berapakah hasil dari 64 ÷ 8 ?", options: ["6", "7", "8", "9"], ans: 2 },
                { q: "Berapakah hasil dari 9 × 4 ?", options: ["32", "36", "40", "28"], ans: 1 },
                { q: "Berapakah 50 ÷ 10 ?", options: ["5", "10", "15", "2"], ans: 0 },
                { q: "Berapakah hasil dari 7 × 7 ?", options: ["42", "49", "56", "63"], ans: 1 },
                { q: "Berapakah hasil dari 36 ÷ 6 ?", options: ["4", "5", "6", "7"], ans: 2 }
            ],
            ipa_smp: [
                { q: "Planet terbesar dalam Tata Surya kita adalah...", options: ["Mars", "Saturnus", "Jupiter", "Neptunus"], ans: 2 },
                { q: "Planet yang dijuluki Planet Merah adalah...", options: ["Venus", "Mars", "Merkurius", "Uranus"], ans: 1 },
                { q: "Pusat tata surya kita adalah...", options: ["Bumi", "Matahari", "Jupiter", "Awan Oort"], ans: 1 },
                { q: "Planet terdekat dari Matahari adalah...", options: ["Venus", "Bumi", "Merkurius", "Mars"], ans: 2 },
                { q: "Planet yang memiliki cincin paling indah & terlihat jelas adalah...", options: ["Jupiter", "Saturnus", "Uranus", "Neptunus"], ans: 1 },
                { q: "Satelit alami milik planet Bumi dinamakan...", options: ["Titan", "Ganymede", "Bulan", "Phobos"], ans: 2 }
            ],
            bio_sd: [
                { q: "Tumbuhan bernapas menggunakan...", options: ["Paru-paru", "Stomata", "Insang", "Trakea"], ans: 1 },
                { q: "Hewan yang bernapas menggunakan insang adalah...", options: ["Kucing", "Ikan", "Burung", "Sapi"], ans: 1 },
                { q: "Berikut yang TERMASUK ciri-ciri makhluk hidup adalah...", options: ["Membuat batu", "Tumbuh & berkembang", "Membeku", "Berkarat"], ans: 1 },
                { q: "Proses tumbuhan hijau membuat makanan sendiri dinamakan...", options: ["Respirasi", "Fotosintesis", "Adaptasi", "Oksidasi"], ans: 1 },
                { q: "Kaktus bertahan di gurun pasir dengan cara memodifikasi daunnya menjadi...", options: ["Bunga", "Duri", "Akar", "Buah"], ans: 1 }
            ]
        };

        let currentMode = 'solo'; // 'solo', 'duel', 'squad'
        let currentQuestions = [];
        let players = [];
        let canvas, ctx;
        let animationFrameId;
        let waterParticles = [];
        let rainParticles = [];
        let rainEnabled = true;

        // UI Event Handlers
        function onSubjectChange() {
            const val = document.getElementById('subjectSelect').value;
            const editor = document.getElementById('customEditor');
            if (val === 'custom') {
                editor.classList.remove('hidden');
            } else {
                editor.classList.add('hidden');
            }
        }

        function selectMode(mode) {
            currentMode = mode;
            ['btnSolo', 'btnDuel', 'btnSquad'].forEach(id => {
                const btn = document.getElementById(id);
                btn.className = "mode-btn btn-game bg-slate-200 text-slate-700 font-game p-3 rounded-2xl text-center border-2 border-slate-300";
            });
            const activeBtn = document.getElementById('btn' + mode.charAt(0).toUpperCase() + mode.slice(1));
            activeBtn.className = "mode-btn btn-game bg-emerald-500 text-white font-game p-3 rounded-2xl text-center border-2 border-emerald-600";
        }

        function toggleBGM() {
            const isPlaying = sound.toggleBGM();
            document.getElementById('bgmToggleBtn').classList.toggle('bg-amber-400', isPlaying);
            document.getElementById('bgmToggleBtn').classList.toggle('bg-rose-500', !isPlaying);
        }

        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(()=>{});
            } else {
                if (document.exitFullscreen) document.exitFullscreen();
            }
        }

        function startGame() {
            sound.init();
            const subjectVal = document.getElementById('subjectSelect').value;
            if (subjectVal === 'custom') {
                try {
                    const customText = document.getElementById('customJsonInput').value;
                    currentQuestions = JSON.parse(customText);
                    if (!Array.isArray(currentQuestions) || currentQuestions.length === 0) throw new Error();
                } catch (e) {
                    alert('Format JSON Soal Custom tidak valid. Mohon periksa kembali formatnya.');
                    return;
                }
            } else {
                currentQuestions = [...QUESTION_DATABASE[subjectVal]];
            }

            // Shuffle questions
            currentQuestions.sort(() => Math.random() - 0.5);

            rainEnabled = document.getElementById('rainEffectToggle').checked;

            // Setup Players based on Mode
            let numPlayers = 1;
            if (currentMode === 'duel') numPlayers = 2;
            if (currentMode === 'squad') numPlayers = 4;

            players = [];
            for (let i = 0; i < numPlayers; i++) {
                players.push({
                    id: i + 1,
                    name: `Pemain ${i + 1}`,
                    score: 0,
                    questionIdx: 0,
                    state: 'IDLE', // 'IDLE', 'JUMPING', 'SINKING', 'FINISHED'
                    frogYProgress: 0,
                    jumpStartPos: { x: 0, y: 0 },
                    jumpTargetPos: { x: 0, y: 0 },
                    jumpProgress: 0,
                    selectedOption: -1,
                    sinkProgress: 0,
                    padYOffset: 0
                });
            }

            document.getElementById('mainMenu').classList.add('hidden');
            document.getElementById('gameOverModal').classList.add('hidden');

            setupCanvas();
            if (animationFrameId) cancelAnimationFrame(animationFrameId);
            gameLoop();
        }

        function setupCanvas() {
            canvas = document.getElementById('gameCanvas');
            ctx = canvas.getContext('2d');
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);

            // Init rain particles
            rainParticles = [];
            for (let i = 0; i < 60; i++) {
                rainParticles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    speed: 12 + Math.random() * 8,
                    length: 15 + Math.random() * 10
                });
            }
        }

        function resizeCanvas() {
            if (!canvas) return;
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        window.addEventListener('pointerdown', (e) => {
            if (!players || players.length === 0) return;
            const rect = canvas.getBoundingClientRect();
            const clickX = e.clientX - rect.left;
            const clickY = e.clientY - rect.top;

            const laneWidth = canvas.width / players.length;

            players.forEach((p, idx) => {
                if (p.state !== 'IDLE') return;

                const laneX = idx * laneWidth;
                // Check if click is inside player's lane
                if (clickX >= laneX && clickX < laneX + laneWidth) {
                    // Check interaction with Lily Pads
                    const q = currentQuestions[p.questionIdx];
                    if (!q) return;

                    const pads = getPadPositions(laneX, laneWidth, canvas.height);
                    pads.forEach((pad, optionIdx) => {
                        const dist = Math.hypot(clickX - pad.x, clickY - pad.y);
                        if (dist < pad.radius) {
                            handlePadClick(p, optionIdx, pad);
                        }
                    });
                }
            });
        });

        function handlePadClick(player, optionIdx, padPos) {
            const q = currentQuestions[player.questionIdx];
            if (!q) return;

            sound.playJump();
            player.selectedOption = optionIdx;
            player.jumpStartPos = getFrogPosition(player);
            player.jumpTargetPos = { x: padPos.x, y: padPos.y };
            player.jumpProgress = 0;

            if (optionIdx === q.ans) {
                player.state = 'JUMPING_CORRECT';
            } else {
                player.state = 'JUMPING_WRONG';
            }
        }

        function getFrogPosition(player) {
            const laneWidth = canvas.width / players.length;
            const laneX = (player.id - 1) * laneWidth;
            return {
                x: laneX + laneWidth / 2,
                y: canvas.height - 90
            };
        }

        function getPadPositions(laneX, laneWidth, canvasHeight) {
            // 4 Lily pads arranged in an ARC or 2x2 grid in the lane
            const padRadius = Math.min(laneWidth / 4.8, 55);
            const centerY = canvasHeight - 280;

            return [
                { x: laneX + laneWidth * 0.22, y: centerY - 40, radius: padRadius },
                { x: laneX + laneWidth * 0.78, y: centerY - 40, radius: padRadius },
                { x: laneX + laneWidth * 0.22, y: centerY + 80, radius: padRadius },
                { x: laneX + laneWidth * 0.78, y: centerY + 80, radius: padRadius }
            ];
        }

        function createSplash(x, y) {
            sound.playSplash();
            for (let i = 0; i < 25; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = 2 + Math.random() * 6;
                waterParticles.push({
                    x: x,
                    y: y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed - 2,
                    radius: 3 + Math.random() * 4,
                    alpha: 1,
                    life: 1
                });
            }
        }

        let waveOffset = 0;
        function gameLoop() {
            waveOffset += 0.05;
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // 1. Draw Water Background
            drawWaterBackground();

            // 2. Draw Rain Effect if enabled
            if (rainEnabled) drawRain();

            // 3. Update & Draw Particles
            updateAndDrawParticles();

            // 4. Draw Player Lanes & Gameplay
            const laneWidth = canvas.width / players.length;
            let allFinished = true;

            players.forEach((p, idx) => {
                const laneX = idx * laneWidth;
                drawLaneBoundary(laneX, laneWidth, idx);
                updatePlayerState(p);
                drawPlayerGame(p, laneX, laneWidth);

                if (p.questionIdx < currentQuestions.length) {
                    allFinished = false;
                }
            });

            // Check if Game Over
            if (allFinished) {
                showGameOver();
                return;
            }

            animationFrameId = requestAnimationFrame(gameLoop);
        }

        function drawWaterBackground() {
            const grad = ctx.createLinearGradient(0, 0, 0, canvas.height);
            grad.addColorStop(0, '#0284c7');
            grad.addColorStop(1, '#0369a1');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Water Ripples/Waves
            ctx.fillStyle = 'rgba(255, 255, 255, 0.08)';
            ctx.beginPath();
            for (let x = 0; x <= canvas.width; x += 20) {
                const y = Math.sin(x * 0.01 + waveOffset) * 12 + canvas.height * 0.4;
                if (x === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.lineTo(canvas.width, canvas.height);
            ctx.lineTo(0, canvas.height);
            ctx.fill();
        }

        function drawRain() {
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            rainParticles.forEach(p => {
                ctx.moveTo(p.x, p.y);
                ctx.lineTo(p.x - 2, p.y + p.length);
                p.y += p.speed;
                p.x -= 0.5;
                if (p.y > canvas.height) {
                    p.y = -20;
                    p.x = Math.random() * canvas.width;
                }
            });
            ctx.stroke();
        }

        function updateAndDrawParticles() {
            for (let i = waterParticles.length - 1; i >= 0; i--) {
                const pt = waterParticles[i];
                pt.x += pt.vx;
                pt.y += pt.vy;
                pt.vy += 0.2; // gravity
                pt.alpha -= 0.025;

                ctx.fillStyle = `rgba(224, 242, 254, ${Math.max(0, pt.alpha)})`;
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, pt.radius, 0, Math.PI * 2);
                ctx.fill();

                if (pt.alpha <= 0) waterParticles.splice(i, 1);
            }
        }

        function drawLaneBoundary(laneX, laneWidth, idx) {
            if (idx > 0) {
                ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';
                ctx.lineWidth = 3;
                ctx.setLineDash([10, 10]);
                ctx.beginPath();
                ctx.moveTo(laneX, 0);
                ctx.lineTo(laneX, canvas.height);
                ctx.stroke();
                ctx.setLineDash([]);
            }
        }

        function updatePlayerState(p) {
            if (p.state === 'JUMPING_CORRECT' || p.state === 'JUMPING_WRONG') {
                p.jumpProgress += 0.06;
                if (p.jumpProgress >= 1) {
                    p.jumpProgress = 1;
                    if (p.state === 'JUMPING_CORRECT') {
                        sound.playCorrect();
                        p.score += 10;
                        p.questionIdx++;
                        p.state = 'IDLE';
                    } else {
                        sound.playWrong();
                        createSplash(p.jumpTargetPos.x, p.jumpTargetPos.y);
                        p.state = 'SINKING';
                        p.sinkProgress = 0;
                    }
                }
            } else if (p.state === 'SINKING') {
                p.sinkProgress += 0.04;
                if (p.sinkProgress >= 1) {
                    p.state = 'IDLE'; // Reset frog position to starting leaf
                }
            }
        }

        function drawPlayerGame(player, laneX, laneWidth) {
            const q = currentQuestions[player.questionIdx];

            // 1. Draw Header / HUD
            ctx.fillStyle = 'rgba(15, 23, 42, 0.4)';
            ctx.roundRect(laneX + 10, 15, laneWidth - 20, 45, 12);
            ctx.fill();

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 16px Quicksand';
            ctx.textAlign = 'left';
            ctx.fillText(`${player.name}`, laneX + 25, 42);

            ctx.textAlign = 'right';
            ctx.fillStyle = '#fbbf24';
            ctx.fillText(`Skor: ${player.score}`, laneX + laneWidth - 25, 42);

            if (!q) {
                // Player Finished
                ctx.textAlign = 'center';
                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 24px Fredoka One';
                ctx.fillText('SELESAI! 🎉', laneX + laneWidth / 2, canvas.height / 2);
                return;
            }

            // 2. Draw Question Box
            ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';
            const qBoxWidth = laneWidth - 30;
            const qBoxX = laneX + 15;
            ctx.roundRect(qBoxX, 75, qBoxWidth, 80, 16);
            ctx.fill();

            ctx.fillStyle = '#0f172a';
            ctx.font = 'bold 15px Quicksand';
            ctx.textAlign = 'center';
            wrapText(ctx, `Soal ${player.questionIdx + 1}: ${q.q}`, qBoxX + qBoxWidth / 2, 105, qBoxWidth - 20, 20);

            // 3. Draw Starting Pad & Answer Pads
            const startPos = getFrogPosition(player);
            drawLilyPad(startPos.x, startPos.y + 15, Math.min(laneWidth / 4, 60), "AWAL", false);

            const padPositions = getPadPositions(laneX, laneWidth, canvas.height);
            padPositions.forEach((pad, idx) => {
                const label = q.options[idx] || '';
                drawLilyPad(pad.x, pad.y, pad.radius, label, true);
            });

            // 4. Draw Frog Animation
            let frogX = startPos.x;
            let frogY = startPos.y;
            let frogScale = 1;
            let frogAlpha = 1;

            if (player.state === 'JUMPING_CORRECT' || player.state === 'JUMPING_WRONG') {
                const t = player.jumpProgress;
                // Parabolic Jump Arc
                frogX = player.jumpStartPos.x + (player.jumpTargetPos.x - player.jumpStartPos.x) * t;
                const directY = player.jumpStartPos.y + (player.jumpTargetPos.y - player.jumpStartPos.y) * t;
                const jumpArc = Math.sin(t * Math.PI) * 90;
                frogY = directY - jumpArc;
                frogScale = 1 + Math.sin(t * Math.PI) * 0.3;
            } else if (player.state === 'SINKING') {
                frogX = player.jumpTargetPos.x;
                frogY = player.jumpTargetPos.y + player.sinkProgress * 30;
                frogScale = Math.max(0, 1 - player.sinkProgress);
                frogAlpha = Math.max(0, 1 - player.sinkProgress);
            }

            drawFrog(frogX, frogY, frogScale, frogAlpha);
        }

        function drawLilyPad(x, y, radius, label, isOption) {
            ctx.save();
            ctx.translate(x, y);

            // Leaf Shadow
            ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';
            ctx.beginPath();
            ctx.arc(5, 5, radius, 0, Math.PI * 2);
            ctx.fill();

            // Leaf Body
            ctx.fillStyle = '#22c55e';
            ctx.beginPath();
            ctx.arc(0, 0, radius, 0.2, Math.PI * 1.85);
            ctx.lineTo(0, 0);
            ctx.closePath();
            ctx.fill();

            // Leaf Veins Detail
            ctx.strokeStyle = '#15803d';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(0, 0); ctx.lineTo(radius * 0.7, 0);
            ctx.moveTo(0, 0); ctx.lineTo(-radius * 0.5, radius * 0.5);
            ctx.moveTo(0, 0); ctx.lineTo(-radius * 0.5, -radius * 0.5);
            ctx.stroke();

            // Flower Accent
            ctx.fillStyle = '#f43f5e';
            ctx.beginPath();
            ctx.arc(-radius * 0.5, -radius * 0.2, 6, 0, Math.PI * 2);
            ctx.fill();

            ctx.restore();

            // Answer Label Text Box
            if (label) {
                ctx.fillStyle = isOption ? '#ffffff' : '#fef08a';
                ctx.font = 'bold 14px Fredoka One';
                ctx.textAlign = 'center';
                ctx.strokeStyle = '#0f172a';
                ctx.lineWidth = 3;
                ctx.strokeText(label, x, y + 5);
                ctx.fillText(label, x, y + 5);
            }
        }

        function drawFrog(x, y, scale = 1, alpha = 1) {
            ctx.save();
            ctx.globalAlpha = alpha;
            ctx.translate(x, y);
            ctx.scale(scale, scale);

            // Shadow
            ctx.fillStyle = 'rgba(0,0,0,0.2)';
            ctx.beginPath();
            ctx.ellipse(0, 22, 20, 8, 0, 0, Math.PI * 2);
            ctx.fill();

            // Back Feet
            ctx.fillStyle = '#15803d';
            ctx.beginPath(); ctx.arc(-22, 10, 10, 0, Math.PI * 2); ctx.fill();
            ctx.beginPath(); ctx.arc(22, 10, 10, 0, Math.PI * 2); ctx.fill();

            // Body
            ctx.fillStyle = '#4ade80';
            ctx.beginPath();
            ctx.ellipse(0, 0, 22, 20, 0, 0, Math.PI * 2);
            ctx.fill();

            // Belly
            ctx.fillStyle = '#bbf7d0';
            ctx.beginPath();
            ctx.ellipse(0, 4, 14, 12, 0, 0, Math.PI * 2);
            ctx.fill();

            // Eyes Outer
            ctx.fillStyle = '#4ade80';
            ctx.beginPath(); ctx.arc(-12, -16, 10, 0, Math.PI * 2); ctx.fill();
            ctx.beginPath(); ctx.arc(12, -16, 10, 0, Math.PI * 2); ctx.fill();

            // Eyes Pupils
            ctx.fillStyle = '#ffffff';
            ctx.beginPath(); ctx.arc(-12, -16, 6, 0, Math.PI * 2); ctx.fill();
            ctx.beginPath(); ctx.arc(12, -16, 6, 0, Math.PI * 2); ctx.fill();

            ctx.fillStyle = '#0f172a';
            ctx.beginPath(); ctx.arc(-12, -16, 3, 0, Math.PI * 2); ctx.fill();
            ctx.beginPath(); ctx.arc(12, -16, 3, 0, Math.PI * 2); ctx.fill();

            // Smile
            ctx.strokeStyle = '#166534';
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            ctx.arc(0, -2, 8, 0.2, Math.PI - 0.2);
            ctx.stroke();

            ctx.restore();
        }

        function wrapText(context, text, x, y, maxWidth, lineHeight) {
            const words = text.split(' ');
            let line = '';
            for (let n = 0; n < words.length; n++) {
                const testLine = line + words[n] + ' ';
                const metrics = context.measureText(testLine);
                const testWidth = metrics.width;
                if (testWidth > maxWidth && n > 0) {
                    context.fillText(line, x, y);
                    line = words[n] + ' ';
                    y += lineHeight;
                } else {
                    line = testLine;
                }
            }
            context.fillText(line, x, y);
        }

        function showGameOver() {
            const modal = document.getElementById('gameOverModal');
            const summary = document.getElementById('scoreSummary');
            summary.innerHTML = '';

            // Sort players by score
            const sorted = [...players].sort((a, b) => b.score - a.score);

            if (players.length > 1) {
                document.getElementById('winnerTitle').innerText = `🏆 ${sorted[0].name} MENANG! 🎉`;
            } else {
                document.getElementById('winnerTitle').innerText = `PERMAINAN SELESAI! 🎉`;
            }

            sorted.forEach((p, idx) => {
                const div = document.createElement('div');
                div.className = "flex justify-between items-center p-3 bg-white/60 rounded-xl border border-slate-200";
                div.innerHTML = `
                    <span class="font-bold text-slate-800">Juara ${idx + 1}: ${p.name}</span>
                    <span class="font-game text-emerald-600 text-lg">${p.score} Pts</span>
                `;
                summary.appendChild(div);
            });

            modal.classList.remove('hidden');
        }

        function returnToMenu() {
            if (animationFrameId) cancelAnimationFrame(animationFrameId);
            document.getElementById('gameOverModal').classList.add('hidden');
            document.getElementById('mainMenu').classList.remove('hidden');
        }
    </script>
